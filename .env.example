# =============================================================
# Freela — Environment Variables
# =============================================================
# Copy this file to `.env.local` and fill in real values.
# Vite exposes any variable prefixed with VITE_ to the client.
# =============================================================

# OpenAI API key (optional — app uses smart mock responses without it)
# Get one at https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# OpenAI model (defaults to gpt-4o-mini which is cheap & fast)
VITE_OPENAI_MODEL=gpt-4o-mini
