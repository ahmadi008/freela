# OpenRouter API key — SERVER-SIDE ONLY (never exposed to the browser).
# Sign up free at https://openrouter.ai, then create a key at
# https://openrouter.ai/settings/keys. Set it in Netlify:
# Site settings → Environment variables → OPENROUTER_API_KEY.
# Free models (ids ending in ":free") cost nothing — no credit card needed.
OPENROUTER_API_KEY=

# Model to use (optional — defaults to a free Google Gemma model).
# Browse more free models: https://openrouter.ai/models?q=free
OPENROUTER_MODEL=google/gemma-4-31b-it:free
